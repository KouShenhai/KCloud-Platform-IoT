<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.laokou.iot.gateway.gatewayimpl.database.GatewayCommandMapper">

	<sql id="selectConditions">
    where del_flag = 0
    <if test="pageQuery.gatewayId != null">
      and gateway_id = #{pageQuery.gatewayId}
    </if>
    <if test="pageQuery.deviceId != null">
      and device_id = #{pageQuery.deviceId}
    </if>
    <if test="pageQuery.status != null">
      and status = #{pageQuery.status}
    </if>
    <if test="pageQuery.command != null and pageQuery.command != ''">
      and command = #{pageQuery.command}
    </if>
    <if test="pageQuery.params.startTime != null and pageQuery.params.startTime != ''">
      and create_time <![CDATA[ >= ]]> #{pageQuery.params.startTime}
    </if>
    <if test="pageQuery.params.endTime != null and pageQuery.params.endTime != ''">
      and create_time <![CDATA[ <= ]]> #{pageQuery.params.endTime}
    </if>
	</sql>

	<select id="selectObjectPage"
			resultType="org.laokou.iot.gateway.gatewayimpl.database.dataobject.GatewayCommandDO">
		select id,
		       create_time,
		       gateway_sn,
		       command,
		       topic,
		       device_sn,
		       device_name,
		       param,
		       error_message,
		       status,
		       reply_payload,
		       reply_status,
		       dispatch_time,
		       reply_time,
		       reply_message
		from iot_gateway_command
		<include refid="selectConditions"/>
		order by id desc
		limit #{pageQuery.pageSize} offset #{pageQuery.pageIndex}
	</select>

	<select id="selectObjectCount" resultType="long">
		select count(1) from iot_gateway_command
		<include refid="selectConditions"/>
	</select>

  <select id="selectVersion" resultType="integer">
    select version
    from iot_gateway_command
    where id = #{id}
  </select>

</mapper>
