<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.laokou.iot.gateway.gatewayimpl.database.GatewayCommandMapper">

	<sql id="selectConditions">
		where del_flag = 0 and gateway_id = #{pageQuery.gatewayId}
	</sql>

	<select id="selectObjectPage"
			resultType="org.laokou.iot.gateway.gatewayimpl.database.dataobject.GatewayCommandDO">
		select id, create_time, session_id, gateway_id, gateway_sn, command, topic,
			device_id, device_sn, device_name, param, error_message, status,
			reply_payload, reply_status, dispatch_time, reply_time, reply_message
		from iot_gateway_command
		<include refid="selectConditions"/>
		order by id desc
		limit #{pageQuery.pageSize} offset #{pageQuery.pageIndex}
	</select>

	<select id="selectObjectCount" resultType="long">
		select count(1) from iot_gateway_command
		<include refid="selectConditions"/>
	</select>

</mapper>
